# ==============================================================================
# PROJETO MERCADO - CONFIGURAÇÕES DE AMBIENTE (.env.example)
# NUNCA insira senhas reais ou segredos de produção neste arquivo.
# Copie este modelo para .env localmente para configurar suas credenciais.
# ==============================================================================

# Porta da aplicação (padrão 3000 localmente e no AI Studio; o Render injeta automaticamente)
PORT=3000

# Ambiente de execução: development | production | test
NODE_ENV=development

# URL de Conexão com o Banco de Dados PostgreSQL
# Exemplo local: postgresql://usuario:senha@localhost:5432/mercado_db
# No Render: fornecida na aba do serviço PostgreSQL do Render (Internal Database URL)
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/mercado_db"

# Segredo para assinatura de Tokens JWT (autenticação segura)
# Deve ser uma sequência aleatória forte de pelo menos 32 caracteres em produção
JWT_SECRET="sua_chave_secreta_jwt_minimo_32_caracteres_aleatorios"
JWT_EXPIRES_IN="8h"

# URL pública da aplicação (injetada no Render ou AI Studio)
APP_URL="http://localhost:3000"
